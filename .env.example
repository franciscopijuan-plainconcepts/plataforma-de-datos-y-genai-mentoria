# PostgreSQL connection parameters for the local data warehouse.
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# All values are externalized (FR-006) so the port/credentials can be
# overridden without code changes.

# --- Database connection ---
POSTGRES_HOST=__postgres_host__
POSTGRES_PORT=___postgres_port__
POSTGRES_DB=__postgres_db__
POSTGRES_USER=__postgres_user__
POSTGRES_PASSWORD=__postgres_password__

# --- Source data ---
# Path is relative to the project root where the CLI is invoked.
SOURCE_FILE=Global Superstore Data.xlsx

# --- Teardown behaviour ---
# Set to "true" to remove the persisted volume on teardown; "false" to keep data.
TEARDOWN_REMOVE_VOLUME=false

# --- Forge LLM (Text-to-SQL v1.x) ---
# Required: the API key for the Forge proxy. The system fails fast if missing.
FORGE_API_KEY=__forge_api_key__
# The Forge proxy endpoint (OpenAI-compatible).
FORGE_BASE_URL=https://forge.plainconcepts.com/v1
# Model name exposed by Forge.
FORGE_MODEL_NAME=glm-5-2
# Max generation tokens for the LLM response.
FORGE_MAX_TOKENS=4096
# Sampling temperature — 0.0 for deterministic SQL generation.
FORGE_TEMPERATURE=0.0

# --- Semantic Layer v2.0 (viewers + governance) ---
# Optional override of the viewers config path. Defaults to `viewers.yaml`
# in the project root. The committed template is `viewers.example.yaml`.
SEMANTIC_VIEWERS_FILE=viewers.yaml
# Environment marker that gates `allows_full_access` (local/dev/test only).
# In any other value, the registry forces allows_full_access=False (governance
# is non-negotiable per constitution Principle IV).
ENV=local

# --- Metabase Integration v2.1 (feature 004) ---
# Local-only credentials for the auto-provisioned Metabase admin user.
# Setup is reproducible via `uv run python -m src.cli.main metabase setup`.
METABASE_HOST=http://localhost:3000
METABASE_PORT=3000
METABASE_ADMIN_EMAIL=admin@plataforma.local
METABASE_ADMIN_PASSWORD=Metabase2026!

# --- Sales Prediction batch seeding (v3.1, runs automatically at the end of `bootstrap`) ---
# Populates the `Predictions` SQL table with deterministic (no-LLM) forecasts
# for the next months, so Metabase/dashboards have data immediately after
# `bootstrap` — see src/mlops/seed_predictions.py. Best-effort: never fails
# bootstrap; safe to leave at defaults.
# Set to "false" to skip auto-seeding entirely (e.g. slower machines/CI).
SEED_SALES_PREDICTIONS=true
# Environment whose promoted model is used to seed forecasts. If no model is
# promoted yet, bootstrap trains + promotes one automatically (dev->staging->prod).
SEED_SALES_PREDICTIONS_ENV=prod
# How many upcoming months to forecast (per representative region/category profile).
SEED_SALES_PREDICTIONS_MONTHS=6

