# PostgreSQL connection parameters for the local data warehouse.
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# All values are externalized (FR-006) so the port/credentials can be
# overridden without code changes.

# --- Database connection ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=global_superstore
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=plataforma_dev

# --- Source data ---
# Path is relative to the project root where the CLI is invoked.
SOURCE_FILE=Global Superstore Data.xlsx

# --- Teardown behaviour ---
# Set to "true" to remove the persisted volume on teardown; "false" to keep data.
TEARDOWN_REMOVE_VOLUME=false
