# PostgreSQL connection parameters for the local data warehouse.
# Copy this file to `.env` and adjust as needed. `.env` is gitignored.
# All values are externalized (FR-006) so the port/credentials can be
# overridden without code changes.

# --- Database connection ---
POSTGRES_HOST=__postgres_host__
POSTGRES_PORT=___postgres_port__
POSTGRES_DB=__postgres_db__
POSTGRES_USER=__postgres_user__
POSTGRES_PASSWORD=__postgres_password__

# --- Source data ---
# Path is relative to the project root where the CLI is invoked.
SOURCE_FILE=Global Superstore Data.xlsx

# --- Teardown behaviour ---
# Set to "true" to remove the persisted volume on teardown; "false" to keep data.
TEARDOWN_REMOVE_VOLUME=false

# --- Forge LLM (Text-to-SQL v1.x) ---
# Required: the API key for the Forge proxy. The system fails fast if missing.
FORGE_API_KEY=__forge_api_key__
# The Forge proxy endpoint (OpenAI-compatible).
FORGE_BASE_URL=https://forge.plainconcepts.com/v1
# Model name exposed by Forge.
FORGE_MODEL_NAME=glm-5-2
# Max generation tokens for the LLM response.
FORGE_MAX_TOKENS=4096
# Sampling temperature — 0.0 for deterministic SQL generation.
FORGE_TEMPERATURE=0.0

